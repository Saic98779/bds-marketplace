# Environment for the bds-backend container (the Jenkinsfile reads it from the server).
# setup-server.sh generates the real file as /etc/bds/bds-backend.container.env; never commit real values.
DB_URL=jdbc:oracle:thin:@//bds-oracle:1521/FREEPDB1
DB_USERNAME=bds
DB_PASSWORD=<generated>
BDS_JWT_SECRET=<48+ random characters>
BDS_DATA_KEY=<48+ random characters; never change once data exists>
BDS_HASH_KEY=<48+ random characters; never change once data exists>
BDS_ADMIN_PASSWORD=<initial password for admin@bdsmarketplace.in>
BDS_EXPOSE_OTP=true
BDS_ALLOWED_ORIGINS=http://localhost:5173
# Optional mail settings (needed before BDS_EXPOSE_OTP can be set to false)
# BDS_MAIL_ENABLED=true
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
