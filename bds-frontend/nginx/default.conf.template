server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;

    client_max_body_size 30M;   # matches the backend upload limit
    server_tokens off;

    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # API calls go to the backend container on the shared Docker network.
    # Resolving at request time lets nginx start even while the backend is being redeployed.
    location /api/ {
        resolver ${DNS_RESOLVER} valid=10s ipv6=off;
        set $api_upstream ${BDS_API_UPSTREAM};
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_read_timeout 120s;
    }

    # Hashed build assets never change, so cache them for a year
    location /assets/ {
        expires 1y;
        try_files $uri =404;
    }

    # Single-page app: unknown paths load index.html, which must not be cached
    location / {
        expires -1;
        try_files $uri $uri/ /index.html;
    }
}
